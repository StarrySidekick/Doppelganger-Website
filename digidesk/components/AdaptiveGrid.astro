---
import { compileCSS, scopeFor, normalizeLayout } from '../src/adaptive-grid.js';
import { renderElement, isTyped, faceOf, tiltFor, isDecor } from '../src/elements.js';
import { queryWorks, validateWorks, typesOf } from '../src/works.js';
import { url } from '../src/url.js';
import { resolveRef, sized, srcset } from '../src/site.js';
import { works as worksData } from 'virtual:digidesk/site';
import LayoutEditor from './LayoutEditor.astro';

// The catalogue is data an editor writes, so a malformed entry is a real thing
// that can reach the build. Fail here rather than shipping a broken feed.
const worksProblems = validateWorks(worksData);
if (worksProblems.length) throw new Error('Invalid works:\n  ' + worksProblems.join('\n  '));
const TYPE = Object.fromEntries(typesOf(worksData).map((t) => [t.id, t]));

// `name` is the layout's filename in the site's src/data/layouts. Passing it
// turns on the in-page editor, but only for a visitor who asks for it.
// `class` lets the page scope its own styling for these ids. Typed objects
// render inside THIS component, so a page's scoped <style> can no longer reach
// them, and bare `#email` in a global block is the id collision hard rule 0 is
// about. A class on the root gives the page somewhere safe to hang its rules.
const { layout: raw, name, chrome = false, class: className } = Astro.props;
const layout = normalizeLayout(raw);

// A scope class derived from the layout. The compiled rules are keyed by
// element id, and ids are global: without this, a second grid on the page
// overwrites the first's column count and every id it shares.
const scope = scopeFor(layout);
const css = compileCSS(layout, scope);

/**
 * The resolvers elements.js asks for.
 *
 * This component is the ONE place where the general engine meets the site
 * being built: elements.js knows nothing about any site. Every site-specific
 * fact an object needs arrives through here, and reaches here through the
 * integration (src/site.js, virtual:digidesk/site), never by importing the
 * site's files by name.
 */
const ctx = {
  image(m) {
    if (!m?.src) return { src: '' };
    // A file committed by the editor. Already downscaled on the way in, so no
    // srcset — the CDN's ?format= trick does not apply to our own files.
    if (m.src?.startsWith('media:')) return { src: url('media/' + m.src.slice(6)) };

    // A layout naming an asset that doesn't exist is a typo in data, and the
    // build is the right place to find out: resolveRef throws.
    const src = resolveRef(m.src, `Layout "${name ?? '?'}"`);
    // The widest entry doubles as the plain src, so a browser ignoring srcset
    // still gets a sized image rather than the multi-megabyte original.
    const widths = m.widths;
    return {
      src: sized(src, widths ? widths[widths.length - 1] : 1000),
      srcset: srcset(src, widths),
      sizes: m.sizes,
    };
  },
  // Hard rule 2: an internal link must go through url(), or it breaks on the
  // deploy subpath. Anything with a scheme (mailto:, https:) passes through.
  link: (href) => (href?.startsWith('/') ? url(href.slice(1)) : href),

  /**
   * What a `feed` object is asking for.
   *
   * elements.js states the QUERY and knows nothing else — not what a work is,
   * not where the catalogue lives, not how an address becomes a URL. This is
   * the one place those are known, exactly as with `image` and `link` above,
   * which is what keeps the whole tool liftable (hard rule 4).
   */
  works(query) {
    const { items, tags, total } = queryWorks(worksData, query);
    return {
      tags,
      total,
      items: items.map((w) => ({
        title: w.title,
        year: w.year,
        blurb: w.blurb,
        tags: w.tags,
        typeLabel: TYPE[w.type]?.label ?? w.type,
        internal: w.link.startsWith('/'),
        href: w.link ? ctx.link(w.link) : '',
        // A work's picture goes through the same sizing as any other image, so
        // a feed of forty gets the CDN's resized copies rather than forty
        // multi-megabyte originals.
        image: w.media?.src ? ctx.image(w.media) : null,
      })),
    };
  },
};

// Typed objects render from data, each wearing its face as a class. Everything
// else is a `slot` and comes from the page's own markup below — which is what
// lets a page be converted one object at a time instead of all at once.
const typed = layout.elements
  .filter(isTyped)
  .map((o) => ({
    id: o.id,
    face: faceOf(o),
    decor: isDecor(o),
    tilt: tiltFor(o.id).toFixed(2) + 'deg',
    html: renderElement(o, ctx),
  }));
---
<div class:list={['ag-root', scope, className]}>
  <div class="ag-grid">
    {typed.map((t) => (
      <div id={t.id} class:list={['ob', `fc-${t.face}`, t.decor && 'ob-decor']} style={`--tilt:${t.tilt}`} set:html={t.html} />
    ))}
    <slot />
  </div>
</div>
<style is:inline set:html={css}></style>
{name && <LayoutEditor name={name} layout={layout} scope={scope} chrome={chrome} />}
