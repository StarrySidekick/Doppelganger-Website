---
/**
 * The site's header and footer.
 *
 * Both are ordinary layouts — `src/data/layouts/header.json` and `footer.json`
 * — rendered by the same grid engine as any page, and editable by the same
 * editor. That is deliberate and it is the lesson from Bureau: everything sits
 * on the grid, and chrome is not a special case with its own rules. The
 * practical payoff is that the header is arrangeable, its wording is editable,
 * and neither needed a line of new engine code.
 *
 * It replaces a fixed-position home icon and sun. Those were markup, so the
 * only way to move them was to edit CSS.
 */
import AdaptiveGrid from './AdaptiveGrid.astro';
import { getLayout } from '../lib/layouts.js';

const { part } = Astro.props;   // 'header' | 'footer'
const layout = getLayout(part);
const Tag = part === 'header' ? 'header' : 'footer';
/**
 * How tall the chrome is, where it sits and whether it follows you are all
 * fields on its own layout, so all three are editable rather than CSS to go
 * and find. They are two independent questions, not one:
 *
 *   place   does it hold its own space (`flow`), or lie over the page (`over`)?
 *   follow  does it stay on screen as you scroll?
 *
 * Emitted as attributes rather than classes so the editor can assert them live
 * from generic code — it finds the frame with `.closest('[data-place]')` and
 * never learns what a site-header is (hard rule 4).
 */
const place = layout.place ?? 'flow';
const follow = layout.follow === true;
---
<Tag class:list={[`site-${part}`]} data-place={place} data-follow={follow ? 'yes' : 'no'}>
  <AdaptiveGrid layout={layout} name={part} chrome class={`${part}-grid`} />
</Tag>

<style is:global>
  /* Scoped by the grid's own class rather than by bare ids — these render
     inside AdaptiveGrid, out of reach of a scoped <style>, and an unscoped
     `#site-nav` is the global-id collision hard rule 0 is about. */
  .site-header, .site-footer {
    width: 100%;
    padding-inline: var(--site-gutter);
  }
  .site-header { padding-block: clamp(10px, 2vw, 22px); }
  /* The four combinations of `place` and `follow`.

     IN THE FLOW the chrome holds its own space, so the page starts after the
     header and ends before the footer. Following, there, is position:sticky —
     NOT fixed, which would take the height out of the flow and make the page
     jump up underneath it by exactly the header's height.

     OVER THE PAGE the chrome is out of the flow entirely and the page's own
     board runs underneath it, which is what a header sitting on a full-bleed
     first row needs. Absolute when it scrolls away with the page, fixed when
     it follows — fixed is the right answer here precisely because the height
     was never in the flow to begin with, so there is nothing to jump. */
  .site-header[data-place="flow"][data-follow="yes"] { position: sticky; top: 0; }
  .site-footer[data-place="flow"][data-follow="yes"] { position: sticky; bottom: 0; }

  .site-header[data-place="over"], .site-footer[data-place="over"] {
    position: absolute; left: 0; right: 0;
  }
  .site-header[data-place="over"] { top: 0; }
  .site-footer[data-place="over"] { bottom: 0; margin-top: 0; }
  .site-header[data-place="over"][data-follow="yes"] { position: fixed; }
  .site-footer[data-place="over"][data-follow="yes"] { position: fixed; }

  /* A footer over the page has no border to sit under — it is on top of the
     board, not after it, and the rule would draw a line across the page. */
  .site-footer[data-place="over"] { border-top: 0; }

  /* Anything not simply in the flow is lifted and gets something to be read
     against, since whatever it now covers shows through. */
  .site-header[data-follow="yes"], .site-footer[data-follow="yes"],
  .site-header[data-place="over"], .site-footer[data-place="over"] {
    z-index: 40;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px);
  }

  /* WHILE UNLOCKED EVERY BOARD IS REACHABLE, so a board laid over the page is
     put back into the flow to be arranged. Unlocked is the board and locked is
     the site — and an overlaying header in edit mode would cover the page
     board's top rows, which is exactly the "I cannot select this" that having
     everything be an object is meant to end. Press the padlock to see the
     truth. */
  html.ag-unlocked .site-header[data-place="over"],
  html.ag-unlocked .site-footer[data-place="over"] {
    position: static; margin-top: revert;
  }
  .site-footer {
    padding-block: clamp(20px, 4vw, 44px) clamp(28px, 5vw, 60px);
    margin-top: auto;
    border-top: 1px solid rgba(255, 255, 255, .12);
  }

  .header-grid #site-home,
  .header-grid #site-sun,
  .header-grid #site-wordmark {
    display: flex; align-items: center;
  }
  .header-grid #site-home { justify-content: flex-start; }
  .header-grid #site-sun { justify-content: flex-end; }
  .header-grid #site-wordmark { justify-content: center; }

  .header-grid #site-home img,
  .header-grid #site-sun img { width: clamp(38px, 5cqi, 78px); height: auto; }
  .header-grid #site-wordmark img { width: 100%; max-width: 380px; height: auto; }

  /* align-self, not display:flex — flex would make each word and link its own
     flex item and collapse the spaces between them. That exact bug ate the
     space in "Email: …" on /links; see hard rule 5. */
  .footer-grid #site-nav,
  .footer-grid #site-colophon {
    align-self: center;
    font-size: clamp(.8rem, 1.5cqi, .95rem);
    line-height: 1.7;
    opacity: .78;
  }
  .footer-grid #site-colophon { text-align: right; }
  .footer-grid a { color: inherit; text-underline-offset: 3px; }
  .footer-grid a:hover { opacity: 1; }

  @container (max-width: 699px) {
    .footer-grid #site-colophon { text-align: left; }
  }
</style>
