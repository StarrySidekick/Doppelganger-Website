---
const { front, back, holo, size = 280 } = Astro.props;
---
<div class="card-container" style={`--card-size:${size}px`}>
  <div class="card">
    <div class="card-front"><img src={front} alt="Front of Timothy's business card" /></div>
    <div class="card-back"><img src={back} alt="Back of Timothy's business card" /></div>
  </div>
</div>

<style define:vars={{ holo: `url(${holo})` }}>
  .card-container {
    perspective: 1000px;
    /* Never wider than its grid cell — a fixed px size overflowed and
       collided with the elements below at narrow widths. */
    width: min(100%, var(--card-size));
    aspect-ratio: 1;
    margin-inline: auto;
  }
  .card {
    width: 100%; height: 100%;
    position: relative;
    transform-style: preserve-3d;
    /* Prefixed name — a bare `spin` is exactly what broke this on Squarespace. */
    animation: cardSpinY 5s infinite linear;
  }
  .card-front, .card-back {
    position: absolute; inset: 0;
    backface-visibility: hidden;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  .card-front { z-index: 2; }
  .card-back { transform: rotateY(180deg); }
  .card-front img, .card-back img { width: 100%; height: 100%; object-fit: cover; }

  .card-front::after, .card-back::after {
    content: ''; position: absolute;
    top: -150px; left: -100px;
    width: 500px; height: 500px;
    background-image: var(--holo);
    background-size: cover;
    opacity: .4;
    animation: holoDrift 10s infinite linear;
    pointer-events: none;
  }

  @keyframes cardSpinY { from { transform: rotateY(0deg) } to { transform: rotateY(360deg) } }
  @keyframes holoDrift { from { transform: rotate(0deg) } to { transform: rotate(360deg) } }

  @media (prefers-reduced-motion: reduce) {
    .card { animation: none; }
    .card-front::after, .card-back::after { animation: none; }
  }
</style>
