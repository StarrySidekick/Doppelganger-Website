---
import { compileCSS, scopeFor, normalizeLayout } from '../lib/adaptive-grid.js';
import { renderElement, isTyped } from '../lib/elements.js';
import { asset, url, sized, srcset } from '../lib/assets.js';
import LayoutEditor from './LayoutEditor.astro';

// `name` is the layout's filename in src/data/layouts. Passing it turns on the
// in-page editor — but only for a visitor who asks for it with ?edit=1.
// `class` lets the page scope its own styling for these ids. Typed elements
// render inside THIS component, so a page's scoped <style> can no longer reach
// them — and bare `#email` in a global block is the id collision hard rule 0 is
// about. A class on the root gives the page somewhere safe to hang its rules.
const { layout: raw, name, class: className } = Astro.props;
const layout = normalizeLayout(raw);

// A scope class derived from the layout. The compiled rules are keyed by
// element id, and ids are global — without this, a second grid on the page
// overwrites the first's column count and every id it shares.
const scope = scopeFor(layout);
const css = compileCSS(layout, scope);

/**
 * The resolvers elements.js asks for.
 *
 * This component is the ONE place where the general engine meets this
 * particular website — elements.js deliberately imports neither assets.js nor
 * anything under src/data, so that the engine could be lifted out whole. Every
 * site-specific fact an element needs arrives through here.
 */
const ctx = {
  image(c) {
    // A file committed by the editor. Already downscaled on the way in, so no
    // srcset — the CDN's ?format= trick does not apply to our own files.
    if (c.src?.startsWith('media:')) return { src: url('media/' + c.src.slice(6)) };

    const key = c.src?.startsWith('asset:') && c.src.slice(6);
    const src = key ? asset[key] : c.src;
    // A layout naming an asset that doesn't exist is a typo in data, and the
    // build is the right place to find out. (The dashed placeholders on /links
    // are a different thing: those are assets known to be missing, kept visible
    // on purpose, and they live in the page's markup as slots.)
    if (key && !src) {
      throw new Error(
        `Layout "${name ?? '?'}" element #${c.id ?? ''} wants asset "${key}", ` +
          `which is not in assets.js. Known: ${Object.keys(asset).join(', ')}`
      );
    }
    // The widest entry doubles as the plain src, so a browser ignoring srcset
    // still gets a sized image rather than the multi-megabyte original.
    const widths = c.widths;
    return {
      src: sized(src, widths ? widths[widths.length - 1] : 1000),
      srcset: srcset(src, widths),
      sizes: c.sizes,
    };
  },
  // Hard rule 2: an internal link must go through url(), or it breaks on the
  // deploy subpath. Anything with a scheme (mailto:, https:) passes through.
  link: (href) => (href?.startsWith('/') ? url(href.slice(1)) : href),
};

// Typed elements render from data. Everything else is a `slot` and comes from
// the page's own markup below — which is what lets a page be converted one
// element at a time instead of all at once.
const typed = layout.elements
  .filter(isTyped)
  .map((e) => ({ id: e.id, html: renderElement(e, { ...ctx, image: (c) => ctx.image({ ...c, id: e.id }) }) }));
---
<div class:list={['ag-root', scope, className]}>
  <div class="ag-grid">
    {typed.map((t) => <div id={t.id} set:html={t.html} />)}
    <slot />
  </div>
</div>
<style is:inline set:html={css}></style>
{name && <LayoutEditor name={name} layout={layout} scope={scope} />}
