---
/**
 * Mounts the layout editor onto an AdaptiveGrid, but only when the URL carries
 * ?edit=1. A visitor never downloads the editor and can never pick a tile up.
 *
 * Saving has three levels: localStorage while you work, "Copy JSON" to hand the
 * file over, and Publish to commit it straight to main.
 */
import { asset } from '../lib/assets.js';
import lookData from '../data/look.json';
const { name, layout, scope } = Astro.props;

// The asset map travels as data so the editor can preview an image the moment
// its source changes. editor.js may not import assets.js — the engine and the
// editor are deliberately free of anything site-specific — so the site hands
// the values over instead. Sixteen short strings, on the two pages that mount
// an editor at all.
const assets = asset;

// The deploy subpath, so the editor can preview an already-committed image.
const base = import.meta.env.BASE_URL;
---

{/* The layout travels as data, not as define:vars — a define:vars script is
    inlined verbatim, so Vite would never rewrite the editor's import path and
    it would 404 in the browser. */}
<script
  type="application/json"
  class="ag-editor-data"
  set:html={JSON.stringify({ name, layout, scope, assets, base, look: lookData })}
/>

<script>
  // Bundled, but tiny: the editor itself is behind a dynamic import, so Vite
  // splits it into its own chunk and a visitor never downloads it.
  if (new URLSearchParams(location.search).has('edit')) {
    for (const node of document.querySelectorAll('script.ag-editor-data')) {
      const { name, layout, scope, assets, base, look } = JSON.parse(node.textContent);
      const root = document.querySelector('.' + scope);
      if (!root) { console.error('[editor] no grid root for scope', scope); continue; }

      const KEY = `doppelganger.layout.${name}`;
      // A layout saved in this browser wins over the built-in one, so work
      // survives a reload. It is only ever this browser until it is committed.
      let start = layout;
      try {
        const saved = localStorage.getItem(KEY);
        if (saved) {
          start = JSON.parse(saved);
          console.info(`[editor] restored your unsaved "${name}" layout from this browser`);
        }
      } catch (err) {
        console.warn('[editor] could not read the saved layout', err);
      }

      import('../lib/editor.js')
        .then(({ mountEditor }) => {
          mountEditor({
            // `published` is what the build rendered; `layout` may be a draft
            // from this browser. The difference is what Publish has to send.
            root, name, layout: start, published: layout, assets, base, look,
            onChange(next) {
              try {
                localStorage.setItem(KEY, JSON.stringify(next));
              } catch (err) {
                // Private browsing and a full quota both throw. A failed save
                // must never take the editor down with it.
                console.warn('[editor] could not save to this browser', err);
              }
            },
          });
          document.documentElement.classList.add('ag-editing');
        })
        .catch((err) => console.error('[editor] failed to load', err));
    }
  }
</script>

<style is:global>
  /* .ag-editing: the editor is mounted (the bar is there).
     .ag-unlocked: you are arranging. Locked is the site exactly as a visitor
     sees it, bar aside — Bureau's one lock for every board (its decision 74). */
  .ag-editing .ob { position: relative; }
  .ag-unlocked .ag-editable { position: relative; cursor: grab; }
  .ag-unlocked .ag-editable::after {
    content: '';
    position: absolute; inset: 0;
    outline: 1px dashed rgba(255,255,255,.22);
    outline-offset: 2px;
    pointer-events: none;
  }
  .ag-unlocked .ag-editable.ag-derived::after { outline-color: rgba(255,196,107,.45); }
  .ag-unlocked .ag-lifted { z-index: 40; }

  /* A tile whose words can be edited says so, and differently from a tile that
     can only be moved — otherwise the only way to discover it is to guess. */
  .ag-unlocked .ag-text { cursor: text; }
  .ag-unlocked .ag-text::after { outline-style: dotted; outline-color: rgba(140,200,255,.5); }
  .ag-unlocked .ag-writing { cursor: text; }
  .ag-unlocked .ag-writing::after {
    outline: 2px solid rgba(140,200,255,.9);
    outline-offset: 3px;
  }
  .ag-unlocked [contenteditable="true"] { outline: none; cursor: text; }
  .ag-unlocked .ag-dragging { opacity: .85; cursor: grabbing; pointer-events: none; }
  .ag-unlocked .ag-dragging.ag-invalid::after { outline-color: rgba(255,107,107,.9); }
  /* an image object with nothing in it yet is the button that chooses a file */
  .ag-unlocked .ob.ag-empty::before {
    content: 'drop an image here';
    position: absolute; inset: 0; display: grid; place-items: center;
    font: 11px/1.3 ui-monospace, monospace; letter-spacing: .06em; text-transform: uppercase;
    color: rgba(255,255,255,.45);
    border: 1px dashed rgba(255,255,255,.3); border-radius: 6px;
  }

  /* The checkerboard: one cell per coordinate, placed in the grid itself, so it
     aligns to the real tracks. Rows here are minmax(…, auto) and grow with
     their content, so a background gradient sized to a cell would drift off
     the truth within a few rows — Bureau can use one because its cells are
     square and uniform. Only ever drawn when unlocked. */
  .ag-cell { display: none; }
  .ag-unlocked .ag-cell {
    display: block; z-index: 0;
    background: var(--board-1, #0c0c0c);
    cursor: cell;
  }
  .ag-unlocked .ag-cell.ag-cell-b { background: var(--board-2, #171717); }
  .ag-unlocked .ag-cell:hover { outline: 1px solid rgba(255,255,255,.35); outline-offset: -1px; }
  .ag-unlocked .ag-grid > .ob, .ag-unlocked .ag-grid > [id] { z-index: 1; }

  .ag-grip {
    position: absolute; width: 14px; height: 14px; z-index: 41;
    background: rgba(255,255,255,.9);
    border-radius: 2px;
    opacity: 0; transition: opacity .12s ease;
  }
  .ag-unlocked .ag-editable:hover .ag-grip { opacity: .9; }
  .ag-grip-nw { top: -7px; left: -7px; cursor: nwse-resize; }
  .ag-grip-ne { top: -7px; right: -7px; cursor: nesw-resize; }
  .ag-grip-se { bottom: -7px; right: -7px; cursor: nwse-resize; }
  .ag-grip-sw { bottom: -7px; left: -7px; cursor: nesw-resize; }

  .ag-ghost {
    border: 1px solid rgba(255,255,255,.55);
    background: rgba(255,255,255,.07);
    border-radius: 4px;
    pointer-events: none;
  }
  .ag-ghost.ag-bad {
    border-color: rgba(255,107,107,.9);
    background: rgba(255,107,107,.12);
  }

  /* Centred with auto margins, not left:50%. With left:50% the bar's available
     width is only the right half of the window, so it wrapped to two lines on a
     1440px screen with room to spare. */
  .ag-bar {
    position: fixed; z-index: 100; left: 0; right: 0; bottom: 18px;
    width: max-content; margin-inline: auto;
    display: flex; align-items: center; gap: 12px;
    padding: 8px 12px;
    background: rgba(20,20,20,.94);
    border: 1px solid rgba(255,255,255,.18);
    border-radius: 8px;
    font: 12px/1.2 ui-monospace, monospace;
    color: #fff;
    backdrop-filter: blur(6px);
    max-width: calc(100vw - 24px); flex-wrap: wrap; justify-content: center;
  }
  .ag-bar button {
    font: inherit; color: inherit; cursor: pointer;
    background: transparent;
    border: 1px solid rgba(255,255,255,.28);
    border-radius: 4px; padding: 4px 9px;
  }
  .ag-bar button:hover { background: rgba(255,255,255,.12); }
  .ag-bar button[aria-current] { background: #fff; color: #000; border-color: #fff; }
  .ag-lock { font-size: 14px; line-height: 1; padding: 3px 8px !important; }
  .ag-lock.on { color: #FFD27A; border-color: rgba(255,210,122,.6) !important; }
  .ag-menu-swatches { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 10px; }
  .ag-menu-swatches label { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .ag-menu-swatches input[type="color"] { width: 34px; height: 24px; padding: 0; border: 1px solid rgba(255,255,255,.28); border-radius: 4px; background: none; }
  .ag-menu-kinds { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .ag-menu-kinds .ag-menu-btn { display: flex; flex-direction: column; gap: 2px; }
  .ag-menu-kinds small { opacity: .55; font-weight: 400; }
  .ag-menu-danger { border-color: rgba(255,107,107,.5) !important; color: #FFB4B4; }
  .ag-menu-danger:hover { background: rgba(255,107,107,.15) !important; }
  .ag-menu-list { margin: 6px 0 0; padding-left: 16px; }
  .ag-menu-list li { margin: 2px 0; }
  .ag-tabs { display: flex; gap: 4px; }
  /* Which grid the bar is acting on. Only shown when there is more than one,
     which on a normal page means header, body and footer. */
  .ag-grids { border-right: 1px solid rgba(255,255,255,.2); padding-right: 10px; }
  .ag-grids button { text-transform: lowercase; }
  /* A picked image is in this tab only until Publish. Saying so is the whole
     point of the badge — losing one to a reload should never be a surprise. */
  .ag-pending {
    padding: 3px 8px; border-radius: 4px;
    background: rgba(255,196,107,.18);
    color: #FFD79A;
    border: 1px solid rgba(255,196,107,.4);
  }
  /* A tile being dragged over is about to have its picture replaced. */
  .ag-unlocked .ag-editable.ag-drop::after { outline: 2px solid rgba(140,255,180,.9); }
  .ag-hint { opacity: .5; }
  /* The hint is the first thing worth losing when the bar runs out of room. */
  @media (max-width: 860px) { .ag-hint { display: none; } }

  /* display:flex would out-rank the browser's own [hidden]{display:none}, so
     hiding the menu by setting .hidden would set the attribute and change
     nothing on screen. State the hidden case explicitly. */
  .ag-menu[hidden], .ag-toast[hidden] { display: none; }
  .ag-menu {
    position: fixed; z-index: 101; min-width: 210px;
    display: flex; flex-direction: column; gap: 6px;
    padding: 10px;
    background: rgba(20,20,20,.97);
    border: 1px solid rgba(255,255,255,.2);
    border-radius: 8px;
    font: 12px/1.35 ui-monospace, monospace; color: #fff;
  }
  .ag-menu-title { font-weight: 700; padding-bottom: 2px; }
  .ag-menu-row { display: flex; justify-content: space-between; gap: 8px; align-items: center; }
  .ag-menu select { font: inherit; background: #111; color: #fff;
    border: 1px solid rgba(255,255,255,.28); border-radius: 4px; padding: 2px 4px; }
  .ag-menu-btn {
    font: inherit; color: inherit; cursor: pointer; text-align: left;
    background: transparent; border: 1px solid rgba(255,255,255,.24);
    border-radius: 4px; padding: 5px 8px;
  }
  .ag-menu-btn:hover:not(:disabled) { background: rgba(255,255,255,.12); }
  .ag-menu-btn:disabled { opacity: .4; cursor: default; }
  .ag-menu-note { opacity: .55; border-top: 1px solid rgba(255,255,255,.14); padding-top: 6px; }
  .ag-menu-note code { background: rgba(255,255,255,.1); padding: 0 3px; border-radius: 2px; }
  .ag-menu-field { display: flex; flex-direction: column; gap: 3px; }
  .ag-menu-field input, .ag-menu-field textarea {
    font: inherit; background: #111; color: #fff;
    border: 1px solid rgba(255,255,255,.28); border-radius: 4px; padding: 4px 6px;
    resize: vertical;
  }
  .ag-menu-kind { font-weight: 400; opacity: .55; }
  .ag-menu-check { display: flex; align-items: center; gap: 6px; }
  .ag-menu-actions { display: flex; gap: 6px; }
  .ag-menu-actions .ag-menu-btn { flex: 1; text-align: center; }
  .ag-menu { max-width: min(340px, calc(100vw - 24px)); }
  .ag-publish { border-color: rgba(255,255,255,.55) !important; }
  .ag-commit { color: inherit; opacity: .8; text-underline-offset: 2px; }

  /* Above, not below: the bar wraps to two lines on a narrow window and a toast
     anchored to the bottom lands on top of it. */
  .ag-toast {
    position: fixed; z-index: 102; left: 0; right: 0; top: 16px;
    width: max-content; margin-inline: auto;
    padding: 7px 13px;
    background: rgba(255,255,255,.95); color: #000;
    border-radius: 5px;
    font: 12px/1.2 ui-monospace, monospace;
  }

  @media (prefers-reduced-motion: reduce) {
    .ag-grip { transition: none; }
  }
</style>
