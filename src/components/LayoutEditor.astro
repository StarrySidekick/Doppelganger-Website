---
/**
 * Mounts the layout editor onto an AdaptiveGrid, but only for someone who has
 * asked to edit — `?edit=1`, or this browser already being in edit mode, or the
 * corner target being pressed while the page is open. A visitor never downloads
 * the editor and can never pick a tile up. `src/lib/edit-mode.js` is the door.
 *
 * Saving has three levels: localStorage while you work, "Copy JSON" to hand the
 * file over, and Publish to commit it straight to main.
 */
import { asset, url } from '../lib/assets.js';
import lookData from '../data/look.json';
import worksData from '../data/works.json';
import { layouts } from '../lib/layouts.js';
const { name, layout, scope, chrome = false } = Astro.props;

/**
 * The working page list.
 *
 * This used to be built from the layout files alone, and that was wrong twice
 * over. There is only ONE layout file that is a page — `links` — so the list
 * showed a single row and looked broken; and every hand-written page (`/`,
 * `/writing`, `/music`, `/contact`) was missing even though those are most of
 * the site. A page is a ROUTE, and a route comes from either a file in
 * src/pages or a layout the dynamic route turns into one.
 *
 * And the href went out bare, so on the deploy subpath `/links?edit=1` was a
 * 404 — hard rule 2, in the one place the editor could not fix for itself.
 * `url()` cannot be imported by src/lib (hard rule 4), so the resolved href
 * travels to the editor as data, exactly like the asset map below.
 */
const CHROME_LAYOUTS = ['header', 'footer'];
// Routes Astro generates that are not pages you would go and arrange.
const NOT_A_PAGE = new Set(['404', '[...slug]']);

const written = Object.keys(import.meta.glob('../pages/*.astro'))
  .map((p) => p.replace(/^.*\/|\.astro$/g, ''))
  .filter((n) => !NOT_A_PAGE.has(n));

// A layout file with no page of its own is still a page — [...slug].astro
// builds it. That is what makes a drawer a page.
const fromLayouts = Object.keys(layouts)
  .filter((n) => !CHROME_LAYOUTS.includes(n) && !written.includes(n));

const NAMED = { index: 'Home', editor: 'Layout editor', 'contact-1': 'Contact (old slug)' };
const titleOf = (n) =>
  NAMED[n] ?? layouts[n]?.title ?? n.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

const pages = [...written, ...fromLayouts]
  .map((n) => ({
    name: n,
    // The address as a visitor types it, for showing; and the real href, base
    // and all, for going there.
    path: n === 'index' ? '/' : `/${n}`,
    href: url(n === 'index' ? '' : n),
    title: titleOf(n),
    // Does this page have a board of its own, or is it markup with the header
    // and footer around it? Both can be opened in edit mode; only the first is
    // a page you can arrange.
    grid: !!layouts[n],
  }))
  .sort((a, b) => (a.path === '/' ? -1 : b.path === '/' ? 1 : a.title.localeCompare(b.title)));

// The asset map travels as data so the editor can preview an image the moment
// its source changes. editor.js may not import assets.js — the engine and the
// editor are deliberately free of anything site-specific — so the site hands
// the values over instead. Sixteen short strings, on the two pages that mount
// an editor at all.
const assets = asset;

// The deploy subpath, so the editor can preview an already-committed image.
const base = import.meta.env.BASE_URL;
---

{/* The layout travels as data, not as define:vars — a define:vars script is
    inlined verbatim, so Vite would never rewrite the editor's import path and
    it would 404 in the browser. */}
<script
  type="application/json"
  class="ag-editor-data"
  set:html={JSON.stringify({ name, layout, scope, assets, base, look: lookData, works: worksData, pages, chrome })}
/>

<script>
  import { editingNow, ENTER_EVENT } from '../lib/edit-mode.js';

  // Bundled, but tiny: the editor itself is behind a dynamic import, so Vite
  // splits it into its own chunk and a visitor never downloads it.
  function mountAll() {
    for (const node of document.querySelectorAll('script.ag-editor-data')) {
      const { name, layout, scope, assets, base, look, works, pages, chrome } = JSON.parse(node.textContent);
      const root = document.querySelector('.' + scope);
      if (!root) { console.error('[editor] no grid root for scope', scope); continue; }

      const KEY = `doppelganger.layout.${name}`;
      // The catalogue is site-wide, like the look, so a draft of it is kept by
      // the shared chrome rather than per board — see WORKS_KEY in editor.js.
      const catalogue = works;
      // A layout saved in this browser wins over the built-in one, so work
      // survives a reload. It is only ever this browser until it is committed.
      let start = layout;
      try {
        const saved = localStorage.getItem(KEY);
        if (saved) {
          start = JSON.parse(saved);
          console.info(`[editor] restored your unsaved "${name}" layout from this browser`);
        }
      } catch (err) {
        console.warn('[editor] could not read the saved layout', err);
      }

      import('../lib/editor.js')
        .then(({ mountEditor }) => {
          mountEditor({
            // `published` is what the build rendered; `layout` may be a draft
            // from this browser. The difference is what Publish has to send.
            root, name, scope, chrome, layout: start, published: layout, assets, base, look, pages,
            works: catalogue,
            onChange(next) {
              try {
                localStorage.setItem(KEY, JSON.stringify(next));
              } catch (err) {
                // Private browsing and a full quota both throw. A failed save
                // must never take the editor down with it.
                console.warn('[editor] could not save to this browser', err);
              }
            },
          });
          document.documentElement.classList.add('ag-editing');
        })
        .catch((err) => console.error('[editor] failed to load', err));
    }
  }

  // Either you arrived editing, or you press the corner and start editing where
  // you stand — no reload, because the page in front of you is already the
  // board. Once, because mounting twice would give every grid two editors.
  if (editingNow()) mountAll();
  else window.addEventListener(ENTER_EVENT, mountAll, { once: true });
</script>

<style is:global>
  /* .ag-editing: the editor is mounted (the bar is there).
     .ag-unlocked: you are arranging. Locked is the site exactly as a visitor
     sees it, bar aside — Bureau's one lock for every board (its decision 74). */
  .ag-editing .ob { position: relative; }

  /* ---------------- touch, while arranging ----------------
     A phone gets three things wrong here by default, and all three are the
     browser being helpful about something else.

     1. A one-finger drag on the page scrolls it, so a tile can never be
        picked up. **This used to be answered with `touch-action: pinch-zoom`
        on the board, and that was the wrong instrument.** It gave the single
        finger to the drag, which cost one-finger scrolling outright; and on
        iOS `pinch-zoom` buys two-finger ZOOM rather than two-finger PAN on an
        unzoomed page, so the scrolling it was supposed to leave you barely
        answered at all. Bureau never sets touch-action on its board. It lets
        the page scroll as a page scrolls and takes the finger only once the
        hold has landed, with a non-passive `touchmove` that preventDefaults
        while — and only while — a drag is armed. That lives in editor.js,
        because it is a question about a gesture and not about a surface.
     2. Tapping anything paints a blue highlight box over it.
     3. Holding anything starts a text selection, and iOS puts a callout
        menu on top of that — both of which fight a hold-to-drag. */

  /* These used to be scoped to `.ag-grid` and its descendants, which left three
     ways to start a selection that then swallowed the hold — and a selection
     begun OUTSIDE a tile still runs through it, because `user-select: none` on
     a child does not stop a drag that started somewhere else:
       - the page around a board: .ag-root's own padding, .site-main, the
         header and footer. A drag that leaves the grid lands here.
       - the board labels sitting on the board, right where you press.
       - every word in the bar and in every panel.
     So while you are arranging, the DOCUMENT is not a selectable surface. */
  .ag-unlocked, .ag-unlocked body {
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    user-select: none;
    -webkit-user-select: none;
  }
  /* The chrome is never a selectable surface, locked or not — the bar is there
     in both modes, and holding "Publish" should not select the word. */
  .ag-editing .ag-bar, .ag-editing .ag-bar *,
  .ag-editing .ag-menu, .ag-editing .ag-menu * {
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    user-select: none;
    -webkit-user-select: none;
  }
  /* …except anything you are actually writing in: the words being edited in
     place, and the fields in the panels — a token, a URL, an alt text. Those
     have to select, and be double-tappable, exactly as a field normally is.

     The .ag-menu/.ag-bar copies are not redundant: `.ag-editing .ag-menu *`
     above is two classes, and would out-specify a bare `.ag-editing input`
     inside a panel — which made the fields in Board and Publish unselectable
     the first time this was written. */
  .ag-editing [contenteditable="true"],
  .ag-editing [contenteditable="true"] *,
  .ag-editing input, .ag-editing textarea, .ag-editing select,
  .ag-editing .ag-menu input, .ag-editing .ag-menu textarea, .ag-editing .ag-menu select,
  .ag-editing .ag-bar input, .ag-editing .ag-bar textarea, .ag-editing .ag-bar select {
    user-select: text; -webkit-user-select: text;
    -webkit-touch-callout: default;
    touch-action: auto;
  }
  /* A picture is the other thing a hold grabs: WebKit starts its own image
     drag, which is a second gesture competing for the same press. */
  .ag-editing .ag-grid img, .ag-editing .ag-grid a {
    -webkit-user-drag: none;
    user-drag: none;
  }
  /* The bar and its panels are chrome: taps there should be instant and
     ordinary, and a long list of settings must still scroll with one finger. */
  .ag-bar, .ag-menu { touch-action: manipulation; }
  .ag-menu { touch-action: pan-y; }

  /* ---------------- which board am I on ----------------
     Three grids up one page look like one page until you go to move
     something. Each says its own name while unlocked, and the one the bar is
     acting on is the one lit. */
  .ag-label { display: none; }
  .ag-unlocked .ag-root { position: relative; }
  .ag-unlocked .ag-label {
    display: block;
    position: absolute; top: -9px; left: 0; z-index: 20;
    padding: 2px 8px;
    font: 10px/1.6 ui-monospace, monospace;
    letter-spacing: .14em; text-transform: uppercase;
    color: rgba(255,255,255,.55);
    background: rgba(20,20,20,.92);
    border: 1px solid rgba(255,255,255,.22);
    border-radius: 3px;
    pointer-events: none;
  }
  .ag-unlocked .ag-root.ag-active > .ag-label {
    color: #0b0b0b; background: #FFD27A; border-color: #FFD27A;
  }
  /* and the active board's edge, so the whole area reads as the live one */
  .ag-unlocked .ag-root { outline: 1px solid transparent; outline-offset: 4px; }
  .ag-unlocked .ag-root.ag-active { outline-color: rgba(255,210,122,.4); }
  .ag-unlocked .ag-editable { position: relative; cursor: grab; }
  /* Drawn just INSIDE the box, not 2px outside it. A board's cells touch by
     default now, so an outline offset outward crossed into the neighbouring
     tile and two adjacent objects shared one doubled line. Inside, an outline
     is exactly the box it belongs to at any gap, including none. */
  .ag-unlocked .ag-editable::after {
    content: '';
    position: absolute; inset: 0;
    outline: 1px dashed rgba(255,255,255,.22);
    outline-offset: -1px;
    pointer-events: none;
  }
  .ag-unlocked .ag-editable.ag-derived::after { outline-color: rgba(255,196,107,.45); }
  /* The one you last pressed, which the arrow keys act on. Solid rather than
     dashed, because "selected" and "movable" are different things to say. */
  .ag-unlocked .ag-editable.ag-selected::after {
    outline: 2px solid var(--accent, #FFD27A);
    outline-offset: -2px;
  }
  /* Lifted: the checkerboard is busy and a thin outline disappeared into it,
     so a tile in your hand lifts off the board with a shadow and a ring that
     do not read as "another square". */
  .ag-unlocked .ag-lifted {
    z-index: 40;
    box-shadow: 0 14px 34px -10px rgba(0,0,0,.95);
  }
  /* Drawn INSIDE the box like every other ring here. It was `outline-offset:
     3px`, three pixels outward, from when the board had an 8px gap everywhere
     — on a board whose cells touch that put the ring into both neighbours, and
     made a tile appear to change size the moment you picked it up. The shadow
     above is what does the lifting; the ring only has to say which one. */
  .ag-unlocked .ag-lifted::after {
    outline: 3px solid #FFD27A !important;
    outline-offset: -3px !important;
    background: rgba(255,210,122,.14);
  }

  /* A tile whose words can be edited says so, and differently from a tile that
     can only be moved — otherwise the only way to discover it is to guess. */
  .ag-unlocked .ag-text { cursor: text; }
  .ag-unlocked .ag-text::after { outline-style: dotted; outline-color: rgba(140,200,255,.5); }
  .ag-unlocked .ag-writing { cursor: text; }
  .ag-unlocked .ag-writing::after {
    outline: 2px solid rgba(140,200,255,.9);
    outline-offset: 3px;
  }
  .ag-unlocked [contenteditable="true"] { outline: none; cursor: text; }
  .ag-unlocked .ag-dragging { opacity: .85; cursor: grabbing; pointer-events: none; }
  .ag-unlocked .ag-dragging.ag-invalid::after { outline-color: rgba(255,107,107,.9); }
  /* an image object with nothing in it yet is the button that chooses a file */
  .ag-unlocked .ob.ag-empty::before {
    content: 'drop an image here';
    position: absolute; inset: 0; display: grid; place-items: center;
    font: 11px/1.3 ui-monospace, monospace; letter-spacing: .06em; text-transform: uppercase;
    color: rgba(255,255,255,.45);
    border: 1px dashed rgba(255,255,255,.3); border-radius: 6px;
  }

  /* The checkerboard: one cell per coordinate, placed in the grid itself, so it
     aligns to the real tracks. Cells are square and uniform, so a background
     gradient WOULD line up now, the way Bureau's does — but a cell is also a
     TARGET. One element per coordinate is what makes clicking bare board mean
     "here" and dragging across it mean "this big". A gradient cannot be
     pressed. Only ever drawn when unlocked. */
  .ag-cell { display: none; }
  .ag-unlocked .ag-cell {
    display: block; z-index: 0;
    background: var(--board-1, #0c0c0c);
    cursor: cell;
  }
  .ag-unlocked .ag-cell.ag-cell-b { background: var(--board-2, #171717); }
  .ag-unlocked .ag-cell:hover { outline: 1px solid rgba(255,255,255,.35); outline-offset: -1px; }
  /* The board is whatever colour the look says, so the grid lines cannot be a
     fixed grey — they are drawn as a translucent seam that reads on both. */
  .ag-unlocked .ag-cell { box-shadow: inset 0 0 0 1px rgba(255,255,255,.05); }
  .ag-unlocked .ag-grid > .ob, .ag-unlocked .ag-grid > [id] { z-index: 1; }

  .ag-grip {
    position: absolute; width: 14px; height: 14px; z-index: 41;
    background: rgba(255,255,255,.9);
    border-radius: 2px;
    opacity: 0; transition: opacity .12s ease;
  }
  .ag-unlocked .ag-editable:hover .ag-grip { opacity: .9; }
  .ag-grip-nw { top: -7px; left: -7px; cursor: nwse-resize; }
  .ag-grip-ne { top: -7px; right: -7px; cursor: nesw-resize; }
  .ag-grip-se { bottom: -7px; right: -7px; cursor: nwse-resize; }
  .ag-grip-sw { bottom: -7px; left: -7px; cursor: nesw-resize; }

  .ag-ghost {
    border: 2px solid #FFD27A;
    background: rgba(255,210,122,.16);
    border-radius: 4px;
    pointer-events: none;
    z-index: 5;
  }
  .ag-ghost.ag-bad {
    border-color: rgba(255,107,107,.9);
    background: rgba(255,107,107,.12);
  }

  /* Centred with auto margins, not left:50%. With left:50% the bar's available
     width is only the right half of the window, so it wrapped to two lines on a
     1440px screen with room to spare. */
  .ag-bar {
    position: fixed; z-index: 100; left: 0; right: 0; bottom: 18px;
    width: max-content; margin-inline: auto;
    display: flex; align-items: center; gap: 12px;
    padding: 8px 12px;
    background: rgba(20,20,20,.94);
    border: 1px solid rgba(255,255,255,.18);
    border-radius: 8px;
    font: 12px/1.2 ui-monospace, monospace;
    color: #fff;
    backdrop-filter: blur(6px);
    max-width: calc(100vw - 24px); flex-wrap: wrap; justify-content: center;
  }
  .ag-bar button {
    font: inherit; color: inherit; cursor: pointer;
    background: transparent;
    border: 1px solid rgba(255,255,255,.28);
    border-radius: 4px;
    /* A 24px button is a miss on a phone. 34 is the smallest that is not. */
    padding: 8px 11px; min-height: 34px;
  }
  .ag-bar button:hover { background: rgba(255,255,255,.12); }
  .ag-bar button[aria-current] { background: #fff; color: #000; border-color: #fff; }
  .ag-lock { font-size: 17px; line-height: 1; padding: 6px 10px !important; }
  .ag-lock.on { color: #FFD27A; border-color: rgba(255,210,122,.6) !important; }
  .ag-menu-swatches { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 10px; }
  .ag-menu-swatches label { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .ag-menu-swatches input[type="color"] { width: 34px; height: 24px; padding: 0; border: 1px solid rgba(255,255,255,.28); border-radius: 4px; background: none; }
  .ag-menu-kinds { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .ag-menu-kinds .ag-menu-btn { display: flex; flex-direction: column; gap: 2px; }
  .ag-menu-kinds small { opacity: .55; font-weight: 400; }
  .ag-menu-pages { grid-template-columns: 1fr; }
  /* Same two-line shape as a row in the list above it, since it belongs to
     that list rather than to the buttons at the bottom of a panel. */
  .ag-menu-new { display: flex; flex-direction: column; gap: 2px; }
  .ag-menu-new small { opacity: .55; }
  .ag-menu-pages [aria-disabled] { opacity: .45; cursor: default; }
  .ag-menu-pages a { text-decoration: none; color: inherit; }
  .ag-menu-pages a[aria-current] { border-color: rgba(255,255,255,.6); }
  /* the sketched box, while you are dragging out a size on bare grid */
  .ag-sketch { border-style: dashed; }
  /* The hold has landed and letting go now opens the picker. Saying so on the
     board is the difference between the picker arriving and it surprising you. */
  .ag-sketch.ag-armed {
    border-style: solid;
    background: rgba(255,210,122,.28);
    box-shadow: 0 0 0 2px rgba(255,210,122,.35);
  }
  /* What a holder holds: one row per thing, four fields and a way to drop it.
     Narrow columns, because the panel is 340px at most and four fields on one
     line is what makes a list of five readable at all. */
  .ag-items { display: flex; flex-direction: column; gap: 4px; max-height: 40vh; overflow-y: auto; }
  .ag-item-row { display: grid; grid-template-columns: .9fr 1.2fr 1.2fr .9fr auto; gap: 3px; }
  .ag-item-row input {
    font: 11px/1.3 ui-monospace, monospace; min-width: 0;
    background: #111; color: #fff;
    border: 1px solid rgba(255,255,255,.24); border-radius: 3px; padding: 3px 4px;
  }
  .ag-item-x { padding: 2px 6px !important; line-height: 1; }
  /* The catalogue, a line per work. Two rows of fields per work rather than
     one long line: a title, a section and a set of tags read as a unit, and
     the when/where/what-it-is sits under them. */
  .ag-works-rows { display: flex; flex-direction: column; gap: 7px; max-height: 46vh; overflow-y: auto; }
  .ag-work-row {
    display: grid; gap: 3px;
    grid-template-columns: 1.4fr 1fr 1.4fr auto;
    grid-template-areas: 'title type tags x' 'year link blurb blurb';
    padding-bottom: 6px; border-bottom: 1px solid rgba(255,255,255,.1);
  }
  .ag-work-row [data-w="title"] { grid-area: title; }
  .ag-work-row [data-w="type"]  { grid-area: type; }
  .ag-work-row [data-w="tags"]  { grid-area: tags; }
  .ag-work-row [data-w="year"]  { grid-area: year; }
  .ag-work-row [data-w="link"]  { grid-area: link; }
  .ag-work-row [data-w="blurb"] { grid-area: blurb; }
  .ag-work-row .ag-item-x { grid-area: x; }
  .ag-work-row input, .ag-work-row select {
    font: 11px/1.3 ui-monospace, monospace; min-width: 0;
    background: #111; color: #fff;
    border: 1px solid rgba(255,255,255,.24); border-radius: 3px; padding: 3px 4px;
  }
  .ag-feed { display: flex; flex-direction: column; gap: 6px; }
  .ag-menu-danger { border-color: rgba(255,107,107,.5) !important; color: #FFB4B4; }
  .ag-menu-danger:hover { background: rgba(255,107,107,.15) !important; }
  .ag-menu-list { margin: 6px 0 0; padding-left: 16px; }
  .ag-menu-list li { margin: 2px 0; }
  .ag-tabs { display: flex; gap: 4px; }
  /* Which grid the bar is acting on. Only shown when there is more than one,
     which on a normal page means header, body and footer. */
  /* Where you are, rather than a pair of toggles asking where you want to be. */
  .ag-where {
    padding: 3px 9px; border-radius: 4px;
    background: rgba(255,210,122,.16); color: #FFD27A;
    border: 1px solid rgba(255,210,122,.35);
    letter-spacing: .06em;
  }
  /* A picked image is in this tab only until Publish. Saying so is the whole
     point of the badge — losing one to a reload should never be a surprise. */
  .ag-pending {
    padding: 3px 8px; border-radius: 4px;
    background: rgba(255,196,107,.18);
    color: #FFD79A;
    border: 1px solid rgba(255,196,107,.4);
  }
  /* A tile being dragged over is about to have its picture replaced. */
  .ag-unlocked .ag-editable.ag-drop::after { outline: 2px solid rgba(140,255,180,.9); }
  .ag-hint { opacity: .5; }
  /* The hint is the first thing worth losing when the bar runs out of room.
     A two-line bar covers the bottom of the board you are arranging, and the
     bar has grown a button since — so this threshold rises with it. */
  @media (max-width: 1280px) { .ag-hint { display: none; } }
  /* On a phone the bar is the only chrome there is, so it gets the full width
     and sits flat against the bottom rather than floating in from it. */
  @media (max-width: 640px) {
    .ag-bar {
      left: 0; right: 0; bottom: 0;
      width: auto; margin: 0;
      border-radius: 0; border-left: 0; border-right: 0; border-bottom: 0;
      padding: 8px 10px calc(8px + env(safe-area-inset-bottom, 0px));
      gap: 8px;
    }
    .ag-menu { max-width: calc(100vw - 16px); max-height: 76vh; overflow-y: auto; }
  }

  /* display:flex would out-rank the browser's own [hidden]{display:none}, so
     hiding the menu by setting .hidden would set the attribute and change
     nothing on screen. State the hidden case explicitly. */
  .ag-menu[hidden], .ag-toast[hidden] { display: none; }
  .ag-menu {
    position: fixed; z-index: 101; min-width: 210px;
    display: flex; flex-direction: column; gap: 6px;
    padding: 10px;
    background: rgba(20,20,20,.97);
    border: 1px solid rgba(255,255,255,.2);
    border-radius: 8px;
    font: 12px/1.35 ui-monospace, monospace; color: #fff;
  }
  /* Every panel carries one, from openMenu, so there is always a way out
     without needing an Escape key or somewhere outside to tap.
     Sticky and its own row, not absolute in a corner: the panel scrolls
     (max-height 84vh), and an absolute child scrolls away with the content
     exactly when a long panel is the one you most need to get out of. */
  .ag-menu-close {
    position: sticky; top: 0; z-index: 2;
    align-self: flex-end; margin-bottom: -10px;
    width: 30px; height: 30px; padding: 0;
    font: 13px/1 ui-monospace, monospace; color: inherit;
    background: rgba(20,20,20,.97);
    border: 1px solid rgba(255,255,255,.22);
    border-radius: 4px; cursor: pointer; opacity: .65;
