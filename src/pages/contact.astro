---
import Base from '../layouts/Base.astro';

// Web3Forms: 250 submissions/month free, works from a static page, no backend.
// Replace with the real access key before this page goes live.
const ACCESS_KEY = 'REPLACE_WITH_WEB3FORMS_ACCESS_KEY';
const ready = !ACCESS_KEY.startsWith('REPLACE');
---

<Base title="Contact" path="/contact">
  <main class="stage">
    <h1>Contact</h1>

    {!ready && (
      <p class="warn">
        Not wired up yet — this form needs a free Web3Forms access key before it
        can send anything. Until then use
        <a href="mailto:TimothyVlangas@gmail.com">TimothyVlangas@gmail.com</a>.
      </p>
    )}

    <form action="https://api.web3forms.com/submit" method="POST">
      <input type="hidden" name="access_key" value={ACCESS_KEY} />
      <input type="hidden" name="from_name" value="starrysidekick.com" />
      <!-- honeypot: bots fill it, humans never see it -->
      <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" />

      <div class="row">
        <label>First name <input type="text" name="first_name" required /></label>
        <label>Last name <input type="text" name="last_name" required /></label>
      </div>
      <label>Email <input type="email" name="email" required /></label>
      <!-- Named `subject` so what the sender types becomes the email's subject.
           It used to post as subject_line while a hidden field fixed the real
           subject, so every message arrived with the same generic title. -->
      <label>Subject <input type="text" name="subject" required /></label>
      <label>Message <textarea name="message" rows="7" required></textarea></label>

      <button type="submit" disabled={!ready}>
        {ready ? 'Send' : 'Send (needs access key)'}
      </button>
    </form>
  </main>
</Base>

<style>
  .stage {
    min-height: 100vh;
    padding: clamp(6rem, 14vh, 9rem) 6vw 5rem;
    max-width: 720px; margin-inline: auto;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 8vw, 5rem);
    margin: 0 0 clamp(1.2rem, 3vw, 2rem);
  }
  .warn {
    border-left: 2px solid rgba(255,196,107,.7);
    background: rgba(255,196,107,.07);
    padding: .8rem 1rem; font-size: .92rem; margin-bottom: 2rem;
  }
  form { display: grid; gap: 1.1rem; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }
  label { display: grid; gap: .35rem; font-family: var(--font-display); font-size: 1.35rem; }
  input, textarea {
    font: inherit; font-family: var(--font-body); font-size: 1rem;
    background: rgba(255,255,255,.05);
    border: 1px solid rgba(255,255,255,.25);
    border-radius: 4px; padding: .6rem .7rem; color: var(--ink);
  }
  input:focus, textarea:focus { outline: 2px solid rgba(255,255,255,.6); outline-offset: 1px; }
  .hp { position: absolute; left: -9999px; }
  button {
    justify-self: start;
    font-family: var(--font-display); font-size: 1.5rem;
    background: transparent; color: var(--ink);
    border: 1px solid rgba(255,255,255,.5); border-radius: 4px;
    padding: .4rem 1.6rem; cursor: pointer;
  }
  button:hover:not(:disabled) { background: rgba(255,255,255,.1); }
  button:disabled { opacity: .45; cursor: not-allowed; }
  @media (max-width: 560px) { .row { grid-template-columns: 1fr; } }
</style>
