---
/**
 * Any layout that has no hand-written page of its own is a page anyway.
 *
 * This is what makes a drawer a page: the editor's "New drawer" writes a
 * layout file and a tile pointing at it, and this route turns the file into
 * the page the tile opens. Hand-written pages (links, writing, …) still win —
 * Astro prefers a static route over a dynamic one — so nothing existing moves,
 * and hard rule 3 holds.
 */
import Base from '../layouts/Base.astro';
import AdaptiveGrid from '../components/AdaptiveGrid.astro';
import { layouts } from '../lib/layouts.js';
import { asset, url } from '../lib/assets.js';

export function getStaticPaths() {
  // Names that already have a file in src/pages, and the two that are chrome.
  const written = new Set(
    Object.keys(import.meta.glob('./*.astro')).map((p) => p.replace(/^\.\/|\.astro$/g, '')),
  );
  written.add('index');
  return Object.keys(layouts)
    .filter((n) => !['header', 'footer'].includes(n) && !written.has(n))
    .map((n) => ({ params: { slug: n }, props: { name: n } }));
}

const { name } = Astro.props;
const layout = layouts[name];
const title = layout.title ?? name.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
// A board says what a search result and a shared link show for it. Both are
// fields on the layout, set in the Board panel, and both are optional — Base
// falls back to the site's own line and wordmark.
const description = layout.description || undefined;
const image = layout.image
  ? (layout.image.startsWith('asset:') ? asset[layout.image.slice(6)]
    : layout.image.startsWith('media:') ? url(`media/${layout.image.slice(6)}`)
    : layout.image)
  : undefined;
---
<Base title={title} path={`/${name}`} description={description} image={image}>
  <main class="drawer-page">
    <h1 class="sr-only">{title}</h1>
    <AdaptiveGrid layout={layout} name={name} class="page-grid" />
  </main>
</Base>

<style is:global>
  /* Padding on the page, never on .ag-grid — the drag maths measures the
     grid's own box, so padding there would shift every tile. */
  .drawer-page { padding-block: clamp(12px, 3vw, 40px); }

  /* A section page's heading. Typed objects render inside AdaptiveGrid, out of
     reach of a scoped <style>, so these hang off classes the layout's own
     markup carries rather than off ids — an unscoped `#works-heading` is the
     global-id collision hard rule 0 is about. */
  .drawer-page .page-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 6cqi, 4rem);
    line-height: 1; margin: 0;
  }
  .drawer-page .page-lede {
    margin: .4em 0 0; opacity: .6;
    font-size: clamp(.85rem, 1.4cqi, 1.05rem);
  }
</style>
