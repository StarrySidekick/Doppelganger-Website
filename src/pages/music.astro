---
import Base from '../layouts/Base.astro';
import SiteChrome from '../components/SiteChrome.astro';
import { SOUNDCLOUD } from '../lib/assets.js';

const sets = [
  { title: 'SoundCloud', href: SOUNDCLOUD, note: 'Everything, in one place' },
  { title: 'Unlisted', href: SOUNDCLOUD + '/sets/unlisted-secret-website/s-yNczkEJ2C5o',
    note: 'The secret website set' },
];
---

<Base title="Music" path="/music">
  <SiteChrome />
  <main class="stage">
    <h1>Music</h1>
    <ul class="sets">
      {sets.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener">
            <span class="t">{s.title}</span>
            <span class="n">{s.note}</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Base>

<style>
  .stage {
    min-height: 100vh;
    padding: clamp(6rem, 14vh, 9rem) 6vw 5rem;
    max-width: 900px; margin-inline: auto;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 8vw, 5rem);
    margin: 0 0 clamp(1.5rem, 4vw, 3rem);
  }
  .sets { list-style: none; padding: 0; margin: 0; }
  .sets a {
    display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;
    padding: clamp(.8rem, 2vw, 1.2rem) 0;
    border-bottom: 1px solid rgba(255,255,255,.16);
    text-decoration: none; transition: padding-left .2s ease;
  }
  .sets a:hover { padding-left: .7rem; }
  .t { font-family: var(--font-display); font-size: clamp(1.5rem, 3.6vw, 2.3rem); }
  .n { font-size: .95rem; opacity: .55; text-align: right; }
</style>
