---
/**
 * The home page, as a board.
 *
 * It used to be hand-written markup carried over from the Squarespace site —
 * a wordmark, four section buttons, a persona with mail and links flanking it
 * — none of which was an object, so none of it could be selected, long-pressed
 * or deleted in the editor. It is an ordinary layout now
 * (src/data/layouts/index.json) like every other page.
 *
 * `/` is the one route the dynamic [...slug] route cannot make — it skips the
 * name `index` deliberately, and a layout named `index` would build `/index`
 * rather than `/`. So this file stays, and is the same six lines that route is.
 */
import Base from '../layouts/Base.astro';
import AdaptiveGrid from '../components/AdaptiveGrid.astro';
import { getLayout } from '../lib/layouts.js';
import { asset, url } from '../lib/assets.js';

const layout = getLayout('index');
// The board's own title, description and share picture, set in the Board panel
// — the same three fields [...slug].astro reads, resolved the same way. Base
// falls back to the site's line and wordmark when the board states none.
const description = layout.description || undefined;
const image = layout.image
  ? (layout.image.startsWith('asset:') ? asset[layout.image.slice(6)]
    : layout.image.startsWith('media:') ? url(`media/${layout.image.slice(6)}`)
    : layout.image)
  : undefined;
---
<Base title={layout.title ?? 'Home'} path="" description={description} image={image}>
  <main class="drawer-page">
    <h1 class="sr-only">{layout.title ?? 'Home'}</h1>
    <AdaptiveGrid layout={layout} name="index" class="page-grid" />
  </main>
</Base>
