---
import Base from '../layouts/Base.astro';
import AdaptiveGrid from '../components/AdaptiveGrid.astro';
import FlipCard from '../components/FlipCard.astro';
import { asset, url } from '../lib/assets.js';
import { getLayout } from '../lib/layouts.js';

/**
 * The first page whose CONTENT is data, not markup.
 *
 * Everything here that is a run of text or a plain image now lives in
 * src/data/layouts/links.json as a typed element, so the in-page editor can
 * change the words as well as move the box. What remains below is only what a
 * content schema would make worse: a component with its own behaviour, and the
 * deliberately-visible placeholders for assets not pulled across yet.
 */
const layout = getLayout('links');
---

<Base title="Links" path="/links">
  <h1 class="sr-only">Links — Timothy Vlangas</h1>
  <AdaptiveGrid layout={layout} name="links" class="links-grid">
    {/* Slot elements. Their boxes are in the layout like everything else; only
        their innards are still markup. Each needs the id the layout names. */}
    <div id="card">
      <FlipCard front={asset.cardFront} back={asset.cardBack} holo={asset.holo} />
    </div>

    <nav id="socials" aria-label="Social links">
      <a href="https://instagram.com/" aria-label="Instagram">
        <img src={asset.instagram} width="327" height="296" alt="" />
      </a>
      <span class="placeholder" data-note="youtube"></span>
      <span class="placeholder" data-note="behance"></span>
      <span class="placeholder" data-note="soundcloud"></span>
      <span class="placeholder" data-note="linkedin"></span>
    </nav>
  </AdaptiveGrid>
</Base>

<style is:global>
  /* Global, but scoped by .links-grid rather than left on bare ids.
     These rules have to be global because the typed elements they style are
     rendered inside AdaptiveGrid, where this file's scoped styles cannot
     reach — and an unscoped `#email` would be exactly the global-id collision
     hard rule 0 exists for. */
  .links-grid #email,
  .links-grid #phone {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.4cqi, 2.1rem);
    letter-spacing: .03em;
    /* align-self, NOT display:flex + align-items.
       Both centre the line in its row, but flex makes every child a flex item
       and collapses the whitespace BETWEEN them — so "Email: <a>…</a>" rendered
       as "Email:TimothyVlangas@…". Any text element holding a label beside a
       link would hit that, and it survives a passing build and a screenshot
       glance. Centring the element in its own track leaves inline flow alone. */
    align-self: center;
  }
  .links-grid #email a,
  .links-grid #phone a { text-decoration: none; color: inherit; }
  .links-grid #email a:hover,
  .links-grid #phone a:hover { text-decoration: underline; }

  /* The board is rigid, so a slot's contents have to fit the box they were
     given rather than push it. `container-type: size` lets the card measure
     BOTH sides of its tile, so it takes the smaller — without it the card was
     280px square inside a 241px-tall box on a phone, and clipped. */
  .links-grid #card {
    display: flex; align-items: center; justify-content: center;
    container-type: size;
  }
  .links-grid #card .card-container { width: min(100cqi, 100cqh, 280px); }

  .links-grid #socials {
    display: flex; align-items: flex-start; justify-content: center;
    gap: clamp(10px, 2cqi, 28px);
  }
  .links-grid #socials img { width: clamp(34px, 4cqi, 56px); aspect-ratio: 1; }

  .links-grid #nav-home,
  .links-grid #nav-sun {
    display: flex; align-items: center; justify-content: center;
    text-decoration: none;
  }
  /* Sized in cqi to match SiteChrome's clamp(44px, 5vw, 82px) elsewhere.
     Not height:100% — the row is minmax(..., auto), so a percentage height
     would be circular and resolve to the image's 480px intrinsic size. */
  .links-grid #nav-home img,
  .links-grid #nav-sun img { width: clamp(36px, 5cqi, 82px); }

  .links-grid #qr img { width: 100%; height: 100%; object-fit: contain; }

  /* Slots whose original assets aren't pulled across yet — visible on purpose.
     The label sits BELOW the box: "SOUNDCLOUD" needs ~63px and the box is as
     narrow as 34px, so a label inside it overflowed and collided with its
     neighbours at mobile widths. */
  .links-grid .placeholder {
    display: flex; flex-direction: column; align-items: center; gap: 5px;
  }
  .links-grid .placeholder::before {
    content: '';
    width: clamp(34px, 4cqi, 56px);
    aspect-ratio: 1;
    border: 1px dashed rgba(255,255,255,.28);
    border-radius: 6px;
  }
  .links-grid .placeholder::after {
    content: attr(data-note);
    font: 9px/1 ui-monospace, monospace;
    color: rgba(255,255,255,.4);
    text-transform: uppercase; letter-spacing: .04em;
    white-space: nowrap;
  }
</style>
