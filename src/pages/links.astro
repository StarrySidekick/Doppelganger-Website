---
import Base from '../layouts/Base.astro';
import AdaptiveGrid from '../components/AdaptiveGrid.astro';
import FlipCard from '../components/FlipCard.astro';

const CDN = 'https://static1.squarespace.com/static/61b0ddefeda7f80c8b2a6085/t';
const IMG = 'https://images.squarespace-cdn.com/content/v1/61b0ddefeda7f80c8b2a6085';

// TEMPORARY: assets still served from Squarespace's CDN so the page renders
// truthfully today. They move into /public before anything goes live.
const card = {
  front: `${CDN}/65f4b890ba886409c5d454ee/1710536848659/Business_Card_Front_Blue.png`,
  back:  `${CDN}/65f4b9c2bb62673336cf473c/1710537154891/Business_Card_Back.png`,
  holo:  `${CDN}/65f4c128f5898d008359bc18/1710539049134/Holo+Small.jpg`,
};
const qr = `${IMG}/fd2c5124-b728-4df7-a3cb-bf922ece4bd5/QR_Code.png`;
const instagram = `${IMG}/bf18e077-6322-4ceb-ac0a-1fcf32a96299/Instagram.png`;

// The layout, authored once. Narrow behaviour is derived from `flow`.
const layout = {
  columns: 24, rowHeight: 26, gap: 8, reflowBelow: 700,
  elements: [
    { id: 'nav-home', col: [1, 3],  row: [1, 3],  flow: 'pin'   },
    { id: 'nav-sun',  col: [22, 3], row: [1, 3],  flow: 'pin'   },
    { id: 'card',     col: [10, 6], row: [5, 8],  flow: 'full'  },
    { id: 'email',    col: [2, 8],  row: [9, 2],  flow: 'stack' },
    { id: 'phone',    col: [3, 7],  row: [12, 2], flow: 'stack' },
    { id: 'socials',  col: [8, 10], row: [15, 3], flow: 'full'  },
    { id: 'qr',       col: [11, 4], row: [19, 5], flow: 'keep'  },
  ],
};
---

<Base title="Links" path="/links">
  <AdaptiveGrid layout={layout}>
    <a id="nav-home" href="/" aria-label="Home"><span class="glyph">⌂</span></a>
    <div id="nav-sun" class="placeholder" data-note="sun mark"></div>

    <div id="card">
      <FlipCard front={card.front} back={card.back} holo={card.holo} />
    </div>

    <p id="email"><a href="mailto:TimothyVlangas@gmail.com">Email: TimothyVlangas@gmail.com</a></p>
    <p id="phone"><a href="tel:+14012978580">Phone: 401-297-8580</a></p>

    <nav id="socials" aria-label="Social links">
      <a href="https://instagram.com/" aria-label="Instagram"><img src={instagram} alt="" /></a>
      <span class="placeholder small" data-note="youtube"></span>
      <span class="placeholder small" data-note="behance"></span>
      <span class="placeholder small" data-note="soundcloud"></span>
      <span class="placeholder small" data-note="linkedin"></span>
    </nav>

    <div id="qr"><img src={qr} alt="QR code linking to this page" /></div>
  </AdaptiveGrid>
</Base>

<style>
  #email, #phone {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.4cqi, 2.1rem);
    letter-spacing: .03em;
    display: flex; align-items: center;
  }
  #email a, #phone a { text-decoration: none; }
  #email a:hover, #phone a:hover { text-decoration: underline; }

  #card { display: flex; align-items: center; justify-content: center; }

  #socials {
    display: flex; align-items: center; justify-content: center;
    gap: clamp(10px, 2cqi, 28px);
  }
  #socials img, #socials .placeholder { width: clamp(34px, 4cqi, 56px); aspect-ratio: 1; }

  #nav-home {
    display: flex; align-items: center; justify-content: center;
    text-decoration: none; font-size: clamp(24px, 3cqi, 40px);
  }
  #qr img { width: 100%; height: 100%; object-fit: contain; }

  /* Slots whose original assets aren't pulled across yet — visible on purpose. */
  .placeholder {
    border: 1px dashed rgba(255,255,255,.28);
    border-radius: 6px;
    position: relative;
  }
  .placeholder::after {
    content: attr(data-note);
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    font: 10px/1 ui-monospace, monospace;
    color: rgba(255,255,255,.4);
    text-transform: uppercase; letter-spacing: .08em;
  }
</style>
