---
import Base from '../layouts/Base.astro';
import AdaptiveGrid from '../components/AdaptiveGrid.astro';
import FlipCard from '../components/FlipCard.astro';
import { asset, url, sized, srcset } from '../lib/assets.js';
import { getLayout } from '../lib/layouts.js';

// The layout, authored once, and now data rather than a literal — see
// src/data/layouts/links.json. Narrow behaviour is derived from `flow`.
const layout = getLayout('links');
---

<Base title="Links" path="/links">
  <h1 class="sr-only">Links — Timothy Vlangas</h1>
  <AdaptiveGrid layout={layout} name="links">
    <!-- The same two marks the rest of the site uses. These stay grid children
         rather than <SiteChrome />, because they are what demonstrates the
         grid's `pin` flow — but they now show the real artwork. -->
    <a id="nav-home" href={url('')} aria-label="Home">
      <img src={sized(asset.home, 300)} srcset={srcset(asset.home, [100, 300])}
           sizes="120px" width="480" height="480" alt="" />
    </a>
    <div id="nav-sun">
      <img src={asset.sun} width="128" height="128" alt="" aria-hidden="true" />
    </div>

    <div id="card">
      <FlipCard front={asset.cardFront} back={asset.cardBack} holo={asset.holo} />
    </div>

    <p id="email"><a href="mailto:TimothyVlangas@gmail.com">Email: TimothyVlangas@gmail.com</a></p>
    <p id="phone"><a href="tel:+14012978580">Phone: 401-297-8580</a></p>

    <nav id="socials" aria-label="Social links">
      <a href="https://instagram.com/" aria-label="Instagram">
        <img src={asset.instagram} width="327" height="296" alt="" />
      </a>
      <span class="placeholder" data-note="youtube"></span>
      <span class="placeholder" data-note="behance"></span>
      <span class="placeholder" data-note="soundcloud"></span>
      <span class="placeholder" data-note="linkedin"></span>
    </nav>

    <div id="qr"><img src={asset.qr} alt="QR code linking to this page" /></div>
  </AdaptiveGrid>
</Base>

<style>
  #email, #phone {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.4cqi, 2.1rem);
    letter-spacing: .03em;
    display: flex; align-items: center;
  }
  #email a, #phone a { text-decoration: none; }
  #email a:hover, #phone a:hover { text-decoration: underline; }

  #card { display: flex; align-items: center; justify-content: center; }

  #socials {
    display: flex; align-items: flex-start; justify-content: center;
    gap: clamp(10px, 2cqi, 28px);
  }
  #socials img { width: clamp(34px, 4cqi, 56px); aspect-ratio: 1; }

  #nav-home, #nav-sun {
    display: flex; align-items: center; justify-content: center;
    text-decoration: none;
  }
  /* Sized in cqi to match SiteChrome's clamp(44px, 5vw, 82px) elsewhere.
     Not height:100% — the row is minmax(..., auto), so a percentage height
     would be circular and resolve to the image's 480px intrinsic size. */
  #nav-home img, #nav-sun img { width: clamp(36px, 5cqi, 82px); }

  #qr img { width: 100%; height: 100%; object-fit: contain; }

  /* Slots whose original assets aren't pulled across yet — visible on purpose.
     The label sits BELOW the box: "SOUNDCLOUD" needs ~63px and the box is as
     narrow as 34px, so a label inside it overflowed and collided with its
     neighbours at mobile widths. */
  .placeholder {
    display: flex; flex-direction: column; align-items: center; gap: 5px;
  }
  .placeholder::before {
    content: '';
    width: clamp(34px, 4cqi, 56px);
    aspect-ratio: 1;
    border: 1px dashed rgba(255,255,255,.28);
    border-radius: 6px;
  }
  .placeholder::after {
    content: attr(data-note);
    font: 9px/1 ui-monospace, monospace;
    color: rgba(255,255,255,.4);
    text-transform: uppercase; letter-spacing: .04em;
    white-space: nowrap;
  }
</style>
