---
import { PROD_ORIGIN, asset, sized, url } from '../lib/assets.js';
import SiteChrome from '../components/SiteChrome.astro';
import { lookCSS, validateLook, normalizeLook } from '../lib/look.js';
import lookData from '../data/look.json';
import '../styles/faces.css';

// The site's look is data too — see src/lib/look.js. A malformed look.json
// fails the build here rather than shipping a page with no colours.
const lookProblems = validateLook(lookData, 'look.json');
if (lookProblems.length) throw new Error('Invalid look:\n  ' + lookProblems.join('\n  '));
const look = normalizeLook(lookData);

const {
  title,
  description = "Timothy Vlangas — writer, game designer, musician and UI/UX designer. Poems, essays, short stories, games and music, all in one place.",
  path = '',
  noindex = false,
  // The picture a shared link shows. A board may name its own; the wordmark
  // is what every other page shows.
  image = null,
} = Astro.props;
const full = `${title} — StarrySidekick.com`;

// Canonical and og:url point at the real domain, not this staging host, so
// nothing has to be rewritten at cutover. PROD_ORIGIN lives in assets.js — the
// domain is written down once, not once per tag.
const canonical = `${PROD_ORIGIN}${path}`;
const ogImage = image
  ? (image.startsWith('http') && image.includes('squarespace') ? sized(image, 1000) : image)
  : sized(asset.wordmark, 1000);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {/* Which build this page came from — the commit count, the commit, and when.
      Answers "has the live site caught up with what I pushed?" from any page,
      with no editor and no console: View Source, or curl the page and grep.
      Same number as /version.json and the editor's bar. */}
  <meta name="build" content={`${__BUILD__.version} · ${__BUILD__.sha} · ${__BUILD__.at}`} />
  <title>{full}</title>
  <meta name="description" content={description} />
  {noindex
    ? <meta name="robots" content="noindex" />
    : <link rel="canonical" href={canonical} />}

  <!-- Generated from Timothy's own Sun.gif, first frame. The only local asset
       so far; everything else still comes from the CDN by design. -->
  <link rel="icon" href={url('favicon.png')} sizes="96x96" type="image/png" />
  <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />

  <!-- SEO surface Squarespace generated for free; now explicit and editable. -->
  <meta property="og:site_name" content="StarrySidekick.com" />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={full} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- FONTS: EB Garamond stands in for Adobe Garamond Pro, which cannot be
       self-hosted and stops working when the Squarespace subscription ends.
       Swap --font-body in one place if a Creative Cloud plan is kept instead. -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Amatic+SC:wght@400;700&family=EB+Garamond:ital,wght@0,400..800;1,400..800&display=swap"
    rel="stylesheet"
  />
  <style is:inline set:html={lookCSS(look)}></style>
</head>
<body class:list={["has-chrome", look.tilt && "look-tilt"]}>
  <!-- Header and footer are layouts, not markup, so they can be arranged and
       reworded in the editor like anything else. Every page gets them; pages no
       longer opt in one at a time. -->
  <SiteChrome part="header" />
  <main class="site-main"><slot /></main>
  <SiteChrome part="footer" />
  <script>
    // A fold and an accordion are live for every visitor, not only in the
    // editor, so this is the one script a published page carries.
    import('../lib/interact.js').then(({ wireInteractions }) => wireInteractions());
    // And the way into edit mode: a target in the bottom-left corner, invisible
    // to anyone who has never used it. It is on every page because edit mode
    // has to be reachable from every page — the parameter in the URL was lost
    // the moment you followed a link. See src/lib/edit-mode.js.
    import('../lib/edit-mode.js').then(({ wireEditEntry }) => wireEditEntry());
  </script>
</body>
</html>

<style is:global>
  :root {
    --font-display: 'Amatic SC', cursive;
    --font-body: 'EB Garamond', Garamond, Georgia, serif;
    --ink: #ffffff;
    --bg: #000000;
  }
  * { box-sizing: border-box; }
  /* For headings a page needs structurally but shouldn't show — /links is a
     visual card, but it still needs an h1 for search and screen readers. */
  .sr-only {
    position: absolute; width: 1px; height: 1px;
    margin: -1px; padding: 0; border: 0;
    clip-path: inset(50%); overflow: hidden; white-space: nowrap;
  }
  /* One gutter for the whole site. The header, the page and the footer are
     three separate grids, and they only read as ONE board if they are the same
     width — otherwise their columns do not line up and their cells are
     different sizes, which is most of what "the grid looks weird" was. */
  :root { --site-gutter: clamp(12px, 3vw, 40px); }
  .site-main { padding-inline: var(--site-gutter); }

  body {
    margin: 0;
    background: var(--paper, var(--bg));
    color: var(--ink);
    font-family: var(--font-body);
    min-height: 100vh;
  }
  /* height:auto is required, not cosmetic. Images now carry width/height
     attributes to reserve space and stop layout shift; without height:auto,
     max-width:100% shrinks the width while the attribute pins the height and
     the image squashes. */
  img { display: block; max-width: 100%; height: auto; }
  a { color: inherit; }
</style>
